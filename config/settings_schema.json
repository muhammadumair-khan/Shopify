[
  {
    "name": "theme_info",
    "theme_name": "DealFits",
    "theme_version": "1.0.0",
    "theme_author": "DealFits",
    "theme_documentation_url": "https://help.shopify.com/",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Brand colours",
    "settings": [
      {
        "type": "color",
        "id": "color_ink",
        "label": "Text / dark",
        "default": "#111111"
      },
      {
        "type": "color",
        "id": "color_bg",
        "label": "Background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_soft",
        "label": "Soft background",
        "default": "#f6f3ec"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Sale accent",
        "default": "#ff3d2e"
      },
      {
        "type": "color",
        "id": "color_highlight",
        "label": "Highlight (yellow)",
        "default": "#ffe14d"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Headings",
        "default": "archivo_n9"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body",
        "default": "assistant_n4"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 100,
        "unit": "px",
        "label": "Page width",
        "default": 1300
      }
    ]
  },
  {
    "name": "Sale badges",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_percent_badge",
        "label": "Show \u201c% OFF\u201d badge on discounted products",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_savings",
        "label": "Show \u201cYou save\u201d amount on product page",
        "default": true
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "quick_add",
        "label": "Show quick \u201c+\u201d add-to-cart on product cards",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_product_tags",
        "label": "Show \u201cNew\u201d and \u201cBest seller\u201d tags",
        "info": "Add the product tag new or best-seller in Shopify admin (Products \u2192 Tags).",
        "default": true
      }
    ]
  },
  {
    "name": "Delivery estimate",
    "settings": [
      {
        "type": "paragraph",
        "content": "Shows \u201cEstimated delivery: Wed 19 Nov \u2013 Thu 20 Nov\u201d on product pages, calculated in UK time from your dispatch cut-off and delivery times (Mon\u2013Fri, skipping bank holidays)."
      },
      {
        "type": "checkbox",
        "id": "delivery_estimate",
        "label": "Show delivery estimate",
        "default": true
      },
      {
        "type": "range",
        "id": "dispatch_cutoff_hour",
        "min": 8,
        "max": 20,
        "step": 1,
        "label": "Orders placed before this hour (UK time) dispatch the same working day",
        "default": 14
      },
      {
        "type": "range",
        "id": "delivery_min_days",
        "min": 1,
        "max": 10,
        "step": 1,
        "label": "Fastest delivery (working days after dispatch)",
        "default": 2
      },
      {
        "type": "range",
        "id": "delivery_max_days",
        "min": 1,
        "max": 14,
        "step": 1,
        "label": "Slowest delivery (working days after dispatch)",
        "default": 3
      },
      {
        "type": "textarea",
        "id": "bank_holidays",
        "label": "Bank holidays (YYYY-MM-DD, comma separated)",
        "info": "England & Wales. Update every year.",
        "default": "2026-12-25, 2026-12-28, 2027-01-01, 2027-03-26, 2027-03-29, 2027-05-03, 2027-05-31, 2027-08-30, 2027-12-27, 2027-12-28"
      }
    ]
  },
  {
    "name": "Size guide",
    "settings": [
      {
        "type": "paragraph",
        "content": "Default size chart shown on products that have no chart of their own. One row per line, columns separated by |. The first line is the header. Per-product charts: Products > (product) > Metafields > Size chart."
      },
      {
        "type": "textarea",
        "id": "size_chart_default",
        "label": "Default size chart (cm)",
        "default": "UK size | Chest (cm) | Waist (cm) | Hip (cm)\nXS (6-8) | 82 | 64 | 88\nS (8-10) | 88 | 70 | 94\nM (12-14) | 96 | 78 | 102\nL (14-16) | 104 | 86 | 110\nXL (16-18) | 112 | 94 | 118"
      },
      {
        "type": "textarea",
        "id": "size_measure_tips",
        "label": "How to measure",
        "default": "Chest: around the fullest part, under your arms.\nWaist: around your natural waist, above the hips.\nHip: around the fullest part of your hips.\nIf you are between sizes, choose the larger size."
      }
    ]
  },
  {
    "name": "Low stock",
    "settings": [
      {
        "type": "paragraph",
        "content": "Shows \u201cOnly N left\u201d on product cards and product pages using your real Shopify inventory (needs Track quantity turned on for the product)."
      },
      {
        "type": "range",
        "id": "low_stock_threshold",
        "min": 0,
        "max": 20,
        "step": 1,
        "label": "Show when stock is at or below (0 = off)",
        "default": 5
      }
    ]
  },
  {
    "name": "Sale countdown",
    "settings": [
      {
        "type": "paragraph",
        "content": "A real, fixed end date. It is shown in the announcement bar, the countdown banner and (optionally) on product pages, and hides itself when it ends."
      },
      {
        "type": "text",
        "id": "sale_end",
        "label": "Sale ends (YYYY-MM-DD HH:MM +offset)",
        "info": "UK time. Use +00:00 in winter and +01:00 in summer, e.g. 2026-11-30 23:59 +00:00. Leave blank for no countdown."
      },
      {
        "type": "text",
        "id": "sale_label",
        "label": "Label",
        "default": "Sale ends in"
      },
      {
        "type": "checkbox",
        "id": "sale_in_bar",
        "label": "Show in announcement bar",
        "default": true
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon (48\u00d748)"
      }
    ]
  }
]