<div class="container auth">
  <h1>Create account</h1>
  {%- form 'create_customer', novalidate: 'novalidate' -%}
    {%- if form.errors -%}<div class="notice notice--err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="g-first">First name</label><input id="g-first" name="customer[first_name]" autocomplete="given-name" value="{{ form.first_name }}"></div>
    <div class="field"><label for="g-last">Last name</label><input id="g-last" name="customer[last_name]" autocomplete="family-name" value="{{ form.last_name }}"></div>
    <div class="field"><label for="g-email">Email</label><input id="g-email" type="email" name="customer[email]" autocomplete="email" required value="{{ form.email }}"></div>
    <div class="field"><label for="g-pass">Password</label><input id="g-pass" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <button class="btn btn--block" type="submit">Create account</button>
  {%- endform -%}
  <p class="auth__alt">Already have an account? <a href="{{ routes.account_login_url }}">Log in</a></p>
</div>
{% schema %}{ "name": "Register" }{% endschema %}
