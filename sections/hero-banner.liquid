<section class="hero">
  <div class="hero__inner">
    <div class="hero__copy">
      {%- if section.settings.eyebrow != blank %}<span class="hero__eyebrow">{{ section.settings.eyebrow }}</span>{% endif -%}
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.text }}</p>
      {%- if section.settings.button_label != blank %}<a class="btn btn--accent" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>{% endif -%}
    </div>
    <div class="hero__img">
      {%- if section.settings.image -%}{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '600,900,1400', sizes: '(max-width:900px) 100vw, 50vw' }}
      {%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag }}{%- endif -%}
    </div>
  </div>
  {%- if section.settings.sticker_big != blank %}<div class="hero__sticker"><div>{{ section.settings.sticker_small }}<b>{{ section.settings.sticker_big }}</b></div></div>{% endif -%}
</section>
{% schema %}
{ "name": "Hero banner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New drop · Limited stock" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Dress sharp. <em>Pay less.</em></p>" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Top-brand clothing at up to 70% off retail. Fresh deals every week." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the deals" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "sticker_small", "label": "Sticker – small text", "default": "Up to" },
    { "type": "text", "id": "sticker_big", "label": "Sticker – big text", "default": "70% off" }
  ],
  "presets": [{ "name": "Hero banner" }] }
{% endschema %}
