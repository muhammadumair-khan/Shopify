<div class="announce">
  {%- if section.settings.link != blank %}<a href="{{ section.settings.link }}">{% endif -%}
  {{ section.settings.text }}
  {%- if section.settings.link != blank %}</a>{% endif -%}
  {%- if settings.sale_in_bar %}{% render 'countdown' %}{% endif -%}
</div>
{% schema %}
{ "name": "Announcement bar",
  "settings": [
    { "type": "inline_richtext", "id": "text", "label": "Text", "default": "<b>Free delivery</b> over £50 · Up to 70% off retail" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Announcement bar" }] }
{% endschema %}
