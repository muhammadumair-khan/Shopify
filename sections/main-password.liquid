<main class="pw" id="main">
  <div class="pw__box">
    <a class="logo" href="{{ routes.root_url }}">{{ section.settings.logo_a }}<span>{{ section.settings.logo_b }}</span></a>
    <p class="pw__tag">{{ section.settings.tag }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <p class="pw__text">{{ section.settings.text }}</p>

    {%- form 'customer', id: 'pw-signup' -%}
      {%- if form.posted_successfully? -%}
        <p class="notice notice--ok" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        {%- if form.errors -%}<div class="notice notice--err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <input type="hidden" name="contact[tags]" value="newsletter, coming-soon">
        <div class="pw__row">
          <label class="sr-only" for="pw-email">{{ 'newsletter.email' | t }}</label>
          <input type="email" id="pw-email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.email' | t }}">
          <button class="btn btn--accent" type="submit">{{ section.settings.button }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <details class="pw__enter" data-pw-details>
      <summary>Have the password? Enter the store</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<div class="notice notice--err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        {%- if shop.password_message != blank %}<p class="pw__msg">{{ shop.password_message }}</p>{% endif -%}
        <div class="pw__row">
          <label class="sr-only" for="pw-pass">Password</label>
          <input type="password" id="pw-pass" name="password" required autocomplete="current-password" placeholder="Password">
          <button class="btn" type="submit">Enter</button>
        </div>
      {%- endform -%}
    </details>
    <p class="pw__admin"><a href="/admin">Store owner? Log in</a></p>
  </div>
</main>
{% schema %}
{ "name": "Password page",
  "settings": [
    { "type": "text", "id": "logo_a", "label": "Logo – first part", "default": "Deal" },
    { "type": "text", "id": "logo_b", "label": "Logo – highlighted part", "default": "Fits" },
    { "type": "text", "id": "tag", "label": "Small label", "default": "Opening soon · UK" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Brand-name clothes. Way less." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "We're getting the first deals ready. Join the list and get 10% off when we open." },
    { "type": "text", "id": "button", "label": "Button", "default": "Notify me" }
  ] }
{% endschema %}
