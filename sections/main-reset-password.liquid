<div class="container auth">
  <h1>Reset your password</h1>
  <p>Enter a new password for {{ email }}.</p>
  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}<div class="notice notice--err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="p-new">New password</label><input id="p-new" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <div class="field"><label for="p-conf">Confirm password</label><input id="p-conf" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <button class="btn btn--block" type="submit">Reset password</button>
  {%- endform -%}
</div>
{% schema %}{ "name": "Reset password" }{% endschema %}
