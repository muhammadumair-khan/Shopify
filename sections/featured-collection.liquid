{%- assign c = section.settings.collection -%}
{%- if c == blank and collections['sale'].products_count > 0 %}{% assign c = collections['sale'] %}{% endif -%}
{%- if c == blank %}{% assign c = collections['all'] %}{% endif -%}
<section class="section{% if section.settings.soft %} section--soft{% endif %}">
  <div class="container">
    <div class="section__head">
      <h2>{{ section.settings.title }}</h2>
      {%- if c != blank %}<a class="link-arrow" href="{{ c.url }}">{{ 'general.view_all' | t }} →</a>{% endif -%}
    </div>
    <div class="grid" style="--cols:{{ section.settings.columns }}">
      {%- if c != blank -%}
        {%- for product in c.products limit: section.settings.limit -%}{% render 'product-card', product: product %}{%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}<div class="card"><div class="card__media">{{ 'product-1' | placeholder_svg_tag }}</div><div class="card__title">Example product</div><div class="price"><span class="price__now">£19.00</span></div></div>{%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Hot deals" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 4, "max": 12, "step": 4, "label": "Products", "default": 8 },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Columns (desktop)", "default": 4 },
    { "type": "checkbox", "id": "soft", "label": "Soft background", "default": false }
  ],
  "presets": [{ "name": "Featured collection" }] }
{% endschema %}
