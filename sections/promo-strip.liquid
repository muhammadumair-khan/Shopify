<section class="strip">
  <h2>{{ section.settings.heading }}</h2>
  <p>{{ section.settings.text }}</p>
  {%- if section.settings.button_label != blank %}<a class="btn btn--light" href="{{ section.settings.link | default: routes.collections_url }}">{{ section.settings.button_label }}</a>{% endif -%}
</section>
{% schema %}
{ "name": "Promo strip",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Clearance: extra 20% off" },
    { "type": "text", "id": "text", "label": "Text", "default": "Prices as marked. While stock lasts." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop clearance" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Promo strip" }] }
{% endschema %}
