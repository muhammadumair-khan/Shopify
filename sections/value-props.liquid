<div class="props">
  {%- for block in section.blocks -%}
    <div class="prop" {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
  {%- endfor -%}
</div>
{% schema %}
{ "name": "Value props",
  "blocks": [{ "type": "prop", "name": "Item", "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Free shipping" },
    { "type": "text", "id": "text", "label": "Text", "default": "On orders over $75" }] }],
  "max_blocks": 4,
  "presets": [{ "name": "Value props", "blocks": [
    { "type": "prop", "settings": { "title": "Up to 70% off", "text": "Real brands, real savings" } },
    { "type": "prop", "settings": { "title": "Free shipping", "text": "On orders over $75" } },
    { "type": "prop", "settings": { "title": "30-day returns", "text": "Don't love it? Send it back" } },
    { "type": "prop", "settings": { "title": "Secure checkout", "text": "Cards, Apple Pay, Shop Pay" } }] }] }
{% endschema %}
