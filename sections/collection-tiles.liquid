<section class="section">
  <div class="container">
    <div class="section__head"><h2>{{ section.settings.title }}</h2></div>
    <div class="tiles" style="--cols:{{ section.blocks.size | at_most: 4 | at_least: 1 }}">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- comment -%} No collection picked: look for one whose handle matches the label (Men -> /collections/men) {%- endcomment -%}
        {%- if c == blank and block.settings.label != blank -%}
          {%- assign guess = block.settings.label | handleize -%}
          {%- assign c = collections[guess] -%}
        {%- endif -%}
        {%- assign img = block.settings.image | default: c.image -%}
        {%- if img == blank and c.products_count > 0 -%}{%- assign img = c.products.first.featured_image -%}{%- endif -%}
        <a class="tile" href="{% if c != blank %}{{ c.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" {{ block.shopify_attributes }}>
          {%- if img != blank -%}
            {{ img | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(max-width:520px) 100vw, 33vw', alt: '' }}
          {%- else -%}
            <div class="tile__ph" aria-hidden="true"></div>
          {%- endif -%}
          <div class="tile__label"><h3>{{ block.settings.label | default: c.title }}</h3><span>{{ block.settings.tag }}</span></div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Collection tiles",
  "settings": [{ "type": "text", "id": "title", "label": "Heading", "default": "Shop by category" }],
  "blocks": [{ "type": "tile", "name": "Tile", "settings": [
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to use the collection whose handle matches the label (e.g. Men → men)." },
    { "type": "text", "id": "label", "label": "Label override" },
    { "type": "text", "id": "tag", "label": "Tag line", "default": "From £7" },
    { "type": "image_picker", "id": "image", "label": "Image override" }] }],
  "max_blocks": 4,
  "presets": [{ "name": "Collection tiles", "blocks": [
    { "type": "tile", "settings": { "label": "Men" } }, { "type": "tile", "settings": { "label": "Women" } }, { "type": "tile", "settings": { "label": "Kids" } }] }] }
{% endschema %}
