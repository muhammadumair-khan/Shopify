<section class="container faq">
  <h1>{{ section.settings.heading }}</h1>
  {%- if section.settings.intro != blank %}<p class="faq__intro">{{ section.settings.intro }}</p>{% endif -%}
  <div class="accs">
    {%- for block in section.blocks -%}
      <details class="acc" {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question }}</summary>
        <div class="acc__body rte">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
  <p class="faq__more">{{ section.settings.more_text }} <a href="{{ section.settings.more_link | default: routes.root_url }}">{{ section.settings.more_label }}</a></p>
</section>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for block in section.blocks %}{"@type":"Question","name":{{ block.settings.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | json }} }}{% unless forloop.last %},{% endunless %}{% endfor %}]}
</script>
{% schema %}
{ "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Quick answers about delivery, sizing and returns." },
    { "type": "text", "id": "more_text", "label": "Footer text", "default": "Still stuck?" },
    { "type": "text", "id": "more_label", "label": "Link label", "default": "Contact us" },
    { "type": "url", "id": "more_link", "label": "Link" }
  ],
  "blocks": [{ "type": "qa", "name": "Question", "settings": [
    { "type": "text", "id": "question", "label": "Question", "default": "Question" },
    { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" }] }],
  "presets": [{ "name": "FAQ" }] }
{% endschema %}
