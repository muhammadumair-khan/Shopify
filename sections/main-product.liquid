{%- assign current = product.selected_or_first_available_variant -%}
<div class="container pdp">
  <div class="pdp__gallery">
    {%- for image in product.images -%}
      {%- if forloop.first -%}{{ image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '600,900,1200', sizes: '(max-width:900px) 100vw, 40vw' }}
      {%- else -%}{{ image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600,900,1200', sizes: '(max-width:900px) 100vw, 40vw' }}{%- endif -%}
    {%- else -%}{{ 'product-1' | placeholder_svg_tag }}{%- endfor -%}
  </div>
  <div class="pdp__info">
    {%- if product.vendor != blank %}<div class="card__vendor">{{ product.vendor }}</div>{% endif -%}
    <h1 style="font-size:clamp(1.8rem,3vw,2.6rem)">{{ product.title }}</h1>
    <div class="pdp__price" data-price>{% render 'variant-price', variant: current %}</div>
    {%- if section.settings.show_countdown %}{% render 'countdown' %}{% endif -%}
    <p class="lowstock" data-lowstock data-threshold="{{ settings.low_stock_threshold }}" hidden></p>

    {%- form 'product', product, id: 'product-form', data-product-form: '' -%}
      <script type="application/json" data-variants>
        [{% for v in product.variants %}{"id":{{ v.id }},"available":{{ v.available }},"options":{{ v.options | json }},"qty":{{ v.inventory_quantity | default: 0 }},"managed":{% if v.inventory_management == 'shopify' %}true{% else %}false{% endif %},"price_html":{% capture ph %}{% render 'variant-price', variant: v %}{% endcapture %}{{ ph | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
      </script>
      <input type="hidden" name="id" value="{{ current.id }}">
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <fieldset class="opt" style="border:0;padding:0;margin:18px 0">
            <legend>{{ option.name }}</legend>
            <div class="opt__vals">
              {%- for value in option.values -%}
                <input type="radio" id="o{{ option.position }}-{{ forloop.index }}" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                <label for="o{{ option.position }}-{{ forloop.index }}">{{ value }}
                  {%- if product.price_varies and product.options.size == 1 -%}
                    {%- for v in product.variants %}{% if v.option1 == value %}<small class="opt__price">{{ v.price | money_without_trailing_zeros }}</small>{% endif %}{% endfor -%}
                  {%- endif -%}
                  {%- if product.options.size == 1 and settings.low_stock_threshold > 0 -%}
                    {%- for v in product.variants %}{% if v.option1 == value and v.inventory_management == 'shopify' and v.inventory_quantity > 0 and v.inventory_quantity <= settings.low_stock_threshold %}<small class="opt__stock">{{ v.inventory_quantity }} left</small>{% endif %}{% endfor -%}
                  {%- endif -%}</label>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}
      {%- endunless -%}
      <button class="btn btn--accent btn--block" type="submit" data-add data-label-sold="{{ 'product.sold_out' | t }}" data-label-add="{{ 'product.add' | t }}" {% unless current.available %}disabled{% endunless %}>
        {%- if current.available %}{{ 'product.add' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif -%}
      </button>
    {%- endform -%}

    {%- if section.settings.show_cutoff %}<p class="cutoff" data-cutoff="{{ section.settings.cutoff_hour }}"></p>{% endif -%}
    <ul class="trust">
      {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}>✓ {{ block.settings.text }}</li>{%- endfor -%}
    </ul>
    <div class="pdp__desc rte">{{ product.description }}<p><small>{{ 'product.size_guide' | t }}</small></p></div>
  </div>
</div>
<div class="atc-bar" data-atc-bar hidden>
  <div class="atc-bar__price" data-bar-price>{{ current.price | money }}</div>
  <button class="btn btn--accent" type="button" data-bar-btn>{% if current.available %}{{ 'product.add' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}</button>
</div>
{% schema %}
{ "name": "Product",
  "settings": [
    { "type": "checkbox", "id": "show_countdown", "label": "Show sale countdown", "default": true },
    { "type": "checkbox", "id": "show_cutoff", "label": "Show “order within… for same-day dispatch”", "default": false },
    { "type": "range", "id": "cutoff_hour", "min": 8, "max": 20, "step": 1, "label": "Dispatch cut-off (UK time, 24h)", "info": "Mon–Fri. Only turn on if you truly dispatch same day.", "default": 14 }
  ],
  "blocks": [{ "type": "trust", "name": "Trust line", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Free delivery over £50" }] }],
  "presets": [{ "name": "Product", "blocks": [
    { "type": "trust", "settings": { "text": "Free delivery over £50" } },
    { "type": "trust", "settings": { "text": "30-day easy returns" } },
    { "type": "trust", "settings": { "text": "100% authentic, brand-name styles" } }] }] }
{% endschema %}
