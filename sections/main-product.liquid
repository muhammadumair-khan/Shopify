{%- assign current = product.selected_or_first_available_variant -%}
<div class="container pdp">
  <div class="gal" data-gallery>
    <div class="gal__main">
      <div class="gal__track" data-gal-track tabindex="0" aria-label="Product photos">
        {%- for image in product.images -%}
          {%- assign alt = image.alt | default: product.title -%}
          <div class="gal__slide" data-image-id="{{ image.id }}" data-full="{{ image | image_url: width: 2000 }}">
            {%- if forloop.first -%}{{ image | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600,900,1200', sizes: '(max-width:900px) 100vw, 45vw', alt: alt }}
            {%- else -%}{{ image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600,900,1200', sizes: '(max-width:900px) 100vw, 45vw', alt: alt }}{%- endif -%}
          </div>
        {%- else -%}<div class="gal__slide">{{ 'product-1' | placeholder_svg_tag }}</div>{%- endfor -%}
      </div>
      {%- if product.images.size > 1 -%}
        <button class="gal__arrow gal__arrow--prev" type="button" data-gal-prev aria-label="Previous photo">&#8249;</button>
        <button class="gal__arrow gal__arrow--next" type="button" data-gal-next aria-label="Next photo">&#8250;</button>
        <span class="gal__count" data-gal-count aria-live="polite">1 / {{ product.images.size }}</span>
      {%- endif -%}
    </div>
    {%- if product.images.size > 1 -%}
      <div class="gal__thumbs" data-gal-thumbs>
        {%- for image in product.images -%}
          <button type="button" class="gal__thumb{% if forloop.first %} is-active{% endif %}" data-gal-thumb="{{ forloop.index0 }}" aria-label="Show photo {{ forloop.index }}">{{ image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '160', sizes: '64px', alt: '' }}</button>
        {%- endfor -%}
      </div>
    {%- endif -%}
    <dialog class="lightbox" data-lightbox aria-label="Zoomed photo"><button type="button" class="lightbox__close" data-lb-close aria-label="Close">&times;</button><img alt="" data-lb-img></dialog>
  </div>
  <div class="pdp__info">
    {%- if product.vendor != blank %}<div class="card__vendor">{{ product.vendor }}</div>{% endif -%}
    <h1 style="font-size:clamp(1.8rem,3vw,2.6rem)">{{ product.title }}</h1>
    <div class="pdp__price" data-price>{% render 'variant-price', variant: current %}</div>
    {%- if section.settings.show_countdown %}{% render 'countdown' %}{% endif -%}
    <p class="lowstock" data-lowstock data-threshold="{{ settings.low_stock_threshold }}" hidden></p>

    {%- unless product.has_only_default_variant %}{% render 'size-guide' %}{% endunless -%}
    {%- form 'product', product, id: 'product-form', data-product-form: '' -%}
      <script type="application/json" data-variants>
        [{% for v in product.variants %}{"id":{{ v.id }},"available":{{ v.available }},"options":{{ v.options | json }},"image":{% if v.featured_image %}{{ v.featured_image.id }}{% else %}null{% endif %},"qty":{{ v.inventory_quantity | default: 0 }},"managed":{% if v.inventory_management == 'shopify' %}true{% else %}false{% endif %},"price_html":{% capture ph %}{% render 'variant-price', variant: v %}{% endcapture %}{{ ph | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
      </script>
      <input type="hidden" name="id" value="{{ current.id }}">
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <fieldset class="opt" style="border:0;padding:0;margin:18px 0">
            <legend>{{ option.name }}</legend>
            <div class="opt__vals">
              {%- for value in option.values -%}
                <input type="radio" id="o{{ option.position }}-{{ forloop.index }}" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                <label for="o{{ option.position }}-{{ forloop.index }}">{{ value }}
                  {%- if product.price_varies and product.options.size == 1 -%}
                    {%- for v in product.variants %}{% if v.option1 == value %}<small class="opt__price">{{ v.price | money_without_trailing_zeros }}</small>{% endif %}{% endfor -%}
                  {%- endif -%}
                  {%- if product.options.size == 1 and settings.low_stock_threshold > 0 -%}
                    {%- for v in product.variants %}{% if v.option1 == value and v.inventory_management == 'shopify' and v.inventory_quantity > 0 and v.inventory_quantity <= settings.low_stock_threshold %}<small class="opt__stock">{{ v.inventory_quantity }} left</small>{% endif %}{% endfor -%}
                  {%- endif -%}</label>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}
      {%- endunless -%}
      <div class="qty"><label for="qty">Quantity</label><input id="qty" type="number" name="quantity" value="1" min="1" max="99" inputmode="numeric"></div>
      <button class="btn btn--accent btn--block" type="submit" data-add data-label-sold="{{ 'product.sold_out' | t }}" data-label-add="{{ 'product.add' | t }}" {% unless current.available %}disabled{% endunless %}>
        {%- if current.available %}{{ 'product.add' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif -%}
      </button>
      <p class="atc-msg" data-atc-msg role="alert" hidden></p>
      {%- if section.settings.show_express %}<div class="express">{{ form | payment_button }}</div>{% endif -%}
    {%- endform -%}

    {%- if settings.delivery_estimate and section.settings.show_delivery -%}
      <p class="deliv" data-delivery data-dl-cutoff="{{ settings.dispatch_cutoff_hour }}" data-min="{{ settings.delivery_min_days }}" data-max="{{ settings.delivery_max_days }}" data-holidays="{{ settings.bank_holidays | strip_newlines | escape }}"><b>Estimated delivery</b> <span data-delivery-text>{{ settings.delivery_min_days }}–{{ settings.delivery_max_days }} working days after dispatch</span></p>
    {%- endif -%}

    {%- if section.settings.show_cutoff %}<p class="cutoff" data-cutoff="{{ section.settings.cutoff_hour }}"></p>{% endif -%}
    <ul class="trust">
      {%- for block in section.blocks -%}{%- if block.type == 'trust' -%}<li {{ block.shopify_attributes }}>✓ {{ block.settings.text }}</li>{%- endif -%}{%- endfor -%}
    </ul>
    {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <div class="pay"><span class="pay__label">Secure checkout</span>
        <ul class="pay__icons">{% for type in shop.enabled_payment_types %}<li>{{ type | payment_type_svg_tag: class: 'pay__icon' }}</li>{% endfor %}</ul>
      </div>
    {%- endif -%}
    <div class="accs">
      {%- for block in section.blocks -%}
        {%- if block.type == 'accordion' -%}
          {%- if block.settings.use_description and product.description == blank -%}{%- continue -%}{%- endif -%}
          <details class="acc"{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
            <summary>{{ block.settings.title }}</summary>
            <div class="acc__body rte">{% if block.settings.use_description %}{{ product.description }}{% else %}{{ block.settings.content }}{% endif %}</div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>
<div class="atc-bar" data-atc-bar hidden>
  <div class="atc-bar__price" data-bar-price>{{ current.price | money }}</div>
  <button class="btn btn--accent" type="button" data-bar-btn>{% if current.available %}{{ 'product.add' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}</button>
</div>
<script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show sale countdown",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_delivery",
      "label": "Show delivery estimate",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_express",
      "label": "Show express checkout buttons (Shop Pay, Apple Pay, Google Pay…)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cutoff",
      "label": "Show “order within… for same-day dispatch”",
      "default": false
    },
    {
      "type": "range",
      "id": "cutoff_hour",
      "min": 8,
      "max": 20,
      "step": 1,
      "label": "Dispatch cut-off for the line above (UK time, 24h)",
      "default": 14
    }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust line",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free delivery over £50"
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Collapsible section",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Product details"
        },
        {
          "type": "checkbox",
          "id": "use_description",
          "label": "Show the product description",
          "default": false
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Text (when not showing the description)"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product"
    }
  ]
}
{% endschema %}
