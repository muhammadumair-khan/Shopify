{%- comment -%} Usage: render 'product-card', product: product {%- endcomment -%}
{%- assign pct = 0 -%}{%- assign min_pct = 100 -%}{%- assign discounted = 0 -%}{%- assign total_qty = 0 -%}{%- assign all_tracked = true -%}
{%- for v in product.variants -%}
  {%- if v.inventory_management == 'shopify' and v.inventory_quantity > 0 -%}{%- assign total_qty = total_qty | plus: v.inventory_quantity -%}
  {%- elsif v.available -%}{%- assign all_tracked = false -%}{%- endif -%}
  {%- if v.compare_at_price > v.price -%}
    {%- assign vp = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price -%}
    {%- assign discounted = discounted | plus: 1 -%}
    {%- if vp > pct %}{% assign pct = vp %}{% endif -%}
    {%- if vp < min_pct %}{% assign min_pct = vp %}{% endif -%}
  {%- endif -%}
{%- endfor -%}
{%- assign tag_label = blank -%}
{%- for t in product.tags -%}
  {%- assign tl = t | downcase -%}
  {%- if tl == 'best-seller' or tl == 'best seller' or tl == 'bestseller' -%}{%- assign tag_label = 'Best seller' -%}
  {%- elsif tl == 'new' and tag_label == blank -%}{%- assign tag_label = 'New' -%}{%- endif -%}
{%- endfor -%}

<div class="card">
  <div class="card__top">
    <a class="card__media-link" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
      <div class="card__media">
        {%- if product.available == false %}<span class="badge badge--out">{{ 'general.sold_out' | t }}</span>
        {%- elsif pct > 0 and settings.show_percent_badge %}<span class="badge">{% if min_pct != pct or discounted < product.variants.size %}{{ 'general.up_to' | t }} {% endif %}{{ 'general.off' | t: percent: pct }}</span>{% endif -%}
        {%- if product.available and settings.show_product_tags and tag_label != blank %}<span class="badge badge--tag{% if tag_label == 'Best seller' %} badge--best{% endif %}">{{ tag_label }}</span>{% endif -%}
        {%- if product.available and all_tracked and total_qty > 0 and total_qty <= settings.low_stock_threshold %}<span class="badge badge--stock">{% if total_qty == 1 %}Only 1 left{% else %}Only {{ total_qty }} left{% endif %}</span>{% endif -%}
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 600 }}" srcset="{{ product.featured_image | image_url: width: 400 }} 400w, {{ product.featured_image | image_url: width: 800 }} 800w" sizes="(max-width:900px) 50vw, 25vw" alt="{{ product.featured_image.alt | escape }}" loading="lazy" decoding="async" width="600" height="800">
          {%- if product.images.size > 1 %}<img src="{{ product.images[1] | image_url: width: 600 }}" alt="" loading="lazy" decoding="async" width="600" height="800">{% endif -%}
        {%- else -%}{{ 'product-1' | placeholder_svg_tag }}{%- endif -%}
      </div>
    </a>
    {%- if product.available and settings.quick_add -%}
      {%- if product.variants.size == 1 -%}
        <button type="button" class="qa__btn" data-qa-add="{{ product.variants.first.id }}" data-title="{{ product.title | escape }}" aria-label="Add {{ product.title | escape }} to cart">+</button>
      {%- elsif product.options.size == 1 -%}
        <button type="button" class="qa__btn" data-qa-open aria-expanded="false" aria-label="Choose {{ product.options[0] | downcase | escape }} for {{ product.title | escape }}">+</button>
        <div class="qa__panel" data-qa-panel hidden role="group" aria-label="Choose {{ product.options[0] | escape }}">
          <span class="qa__label">Add to cart: {{ product.options[0] }}</span>
          <div class="qa__sizes">
            {%- for v in product.variants -%}<button type="button" class="qa__size" data-qa-add="{{ v.id }}" data-title="{{ product.title | escape }}"{% unless v.available %} disabled{% endunless %}>{{ v.option1 }}</button>{%- endfor -%}
          </div>
        </div>
      {%- else -%}
        <a class="qa__btn" href="{{ product.url }}" aria-label="Choose options for {{ product.title | escape }}">+</a>
      {%- endif -%}
    {%- endif -%}
  </div>
  <a class="card__info" href="{{ product.url }}">
    {%- if product.vendor != blank %}<div class="card__vendor">{{ product.vendor }}</div>{% endif -%}
    <div class="card__title">{{ product.title }}</div>
    {%- render 'price', product: product -%}
  </a>
</div>
