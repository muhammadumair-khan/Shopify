{%- comment -%} Usage: render 'payment-icons', blocks: section.blocks, strip: image_or_blank. Order: uploaded PNG blocks, uploaded PNG strip, bundled PNG logos + Shopify icons. {%- endcomment -%}
{%- assign icon_blocks = blocks | where: 'type', 'payment_icon' -%}
{%- if icon_blocks.size > 0 or strip != blank or shop.enabled_payment_types.size > 0 -%}
  <div class="pay"><span class="pay__label">Secure checkout</span>
    {%- if icon_blocks.size > 0 -%}
      <ul class="pay__icons">
        {%- for block in icon_blocks -%}
          {%- if block.settings.image != blank -%}
            <li {{ block.shopify_attributes }}>{{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', class: 'pay__png', widths: '80,120,160', sizes: '60px', alt: block.settings.name }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- elsif strip != blank -%}
      {{ strip | image_url: width: 600 | image_tag: loading: 'lazy', class: 'pay__strip', widths: '300,450,600', sizes: '300px', alt: 'Accepted payment methods' }}
    {%- else -%}
      {%- assign png_types = 'visa,master,american_express,maestro,paypal,discover,diners_club,jcb' | split: ',' -%}
      <ul class="pay__icons">
        {%- for type in shop.enabled_payment_types -%}
          {%- if png_types contains type -%}
            {%- case type -%}
              {%- when 'master' %}{% assign label = 'Mastercard' %}
              {%- when 'american_express' %}{% assign label = 'American Express' %}
              {%- when 'diners_club' %}{% assign label = 'Diners Club' %}
              {%- when 'jcb' %}{% assign label = 'JCB' %}
              {%- else %}{% assign label = type | capitalize %}
            {%- endcase -%}
            {%- assign png = 'pay-' | append: type | append: '.png' -%}
            <li><img class="pay__png" src="{{ png | asset_url }}" alt="{{ label }}" width="38" height="24" loading="lazy" decoding="async"></li>
          {%- else -%}
            <li>{{ type | payment_type_svg_tag: class: 'pay__icon' }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
{%- endif -%}
