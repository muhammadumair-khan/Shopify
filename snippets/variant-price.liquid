{%- comment -%} Usage: render 'variant-price', variant: variant  (price, "Inc. VAT" and "You save" for one variant) {%- endcomment -%}
{%- assign on_sale = false -%}
{%- if variant.compare_at_price > variant.price %}{% assign on_sale = true %}{% endif -%}
<div class="price{% if on_sale %} price--sale{% endif %}">
  <span class="price__now">{{ variant.price | money }}</span>
  {%- if on_sale %}<s class="price__was">{{ variant.compare_at_price | money }}</s>{% endif -%}
  {%- if shop.taxes_included %}<small class="price__vat">Inc. VAT</small>{% endif -%}
</div>
{%- if on_sale and settings.show_savings -%}
  {%- assign save = variant.compare_at_price | minus: variant.price -%}
  {%- assign save_money = save | money -%}
  {%- assign pct = save | times: 100 | divided_by: variant.compare_at_price -%}
  <span class="pdp__save">{{ 'product.save' | t: amount: save_money }} ({{ pct }}%)</span>
{%- endif -%}
