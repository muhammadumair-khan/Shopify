{%- comment -%} Usage: render 'article-card', article: article {%- endcomment -%}
<a class="post" href="{{ article.url }}">
  <div class="post__media">
    {%- if article.image -%}{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(max-width:900px) 100vw, 33vw', alt: article.image.alt | default: article.title }}
    {%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag }}{%- endif -%}
  </div>
  {%- if article.tags.size > 0 %}<span class="post__tag">{{ article.tags.first }}</span>{% endif -%}
  <h3 class="post__title">{{ article.title }}</h3>
  <p class="post__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</p>
  <span class="post__meta">{{ article.published_at | time_tag: format: 'date' }}</span>
</a>
