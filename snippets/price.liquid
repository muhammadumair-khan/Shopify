{%- comment -%} Usage: render 'price', product: product  (listing price; sizes can have different prices) {%- endcomment -%}
{%- assign on_sale = false -%}
{%- if product.compare_at_price > product.price %}{% assign on_sale = true %}{% endif -%}
<div class="price{% if on_sale %} price--sale{% endif %}">
  <span class="price__now">{% if product.price_varies %}{{ 'general.from' | t }} {% endif %}{{ product.price_min | money }}</span>
  {%- if on_sale and product.price_varies == false %}<s class="price__was">{{ product.compare_at_price | money }}</s>{% endif -%}
</div>
