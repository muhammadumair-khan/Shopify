{%- comment -%} Usage: render 'price', product: product {%- endcomment -%}
{%- assign on_sale = false -%}
{%- if product.compare_at_price > product.price %}{% assign on_sale = true %}{% endif -%}
<div class="price{% if on_sale %} price--sale{% endif %}">
  {%- if product.price_varies and on_sale == false %}<span class="price__now">{{ 'general.from' | t }} {{ product.price_min | money }}</span>
  {%- else %}<span class="price__now">{{ product.price | money }}</span>{% endif -%}
  {%- if on_sale %}<s class="price__was">{{ product.compare_at_price | money }}</s>{% endif -%}
</div>
