{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="robots" content="noindex">
  <title>Gift card · {{ shop.name }}</title>
  {%- render 'css-variables' -%}
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
  {{ content_for_header }}
</head>
<body class="template-gift-card">
  <main class="gc">
    <div class="gc__card">
      <a class="logo" href="{{ shop.url }}">{{ shop.name }}</a>
      <p class="gc__label">Gift card</p>
      <p class="gc__value">{{ gift_card.initial_value | money }}</p>
      {%- if gift_card.enabled == false or gift_card.expired -%}
        <p class="notice notice--err">{% if gift_card.expired %}This gift card expired on {{ gift_card.expires_on | date: '%d %B %Y' }}.{% else %}This gift card has been disabled.{% endif %}</p>
      {%- endif -%}
      {%- if gift_card.balance != gift_card.initial_value -%}<p class="gc__bal">Remaining balance: <b>{{ gift_card.balance | money }}</b></p>{%- endif -%}
      <div class="gc__code"><code data-copy-text>{{ gift_card.code | format_code }}</code><button type="button" class="btn" data-copy="{{ gift_card.code | format_code }}">Copy code</button></div>
      {%- if gift_card.expires_on %}<p class="gc__note">Expires {{ gift_card.expires_on | date: '%d %B %Y' }}</p>{% endif -%}
    </div>
    <p class="gc__how">Enter this code at checkout to pay with your gift card.</p>
    <p><a class="btn btn--accent" href="{{ shop.url }}">Start shopping</a>
    {%- if gift_card.pass_url %} <a class="btn" href="{{ gift_card.pass_url }}">Add to Apple Wallet</a>{% endif %}
    <button class="btn" type="button" onclick="window.print()">Print</button></p>
  </main>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
